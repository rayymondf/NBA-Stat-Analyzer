# Runtime
APP_ENV=development
LOG_LEVEL=INFO
EXPOSE_API_DOCS=true
REQUIRE_MODEL=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Local cache and data paths
# NBA_DATA_DIR=C:/absolute/path/to/nba-data
CACHE_MAX_MB=768
CACHE_MEMORY_MAX_MB=64
CACHE_STALE_SECONDS=604800

# Public API abuse controls (per process)
API_RATE_LIMIT_PER_MINUTE=240
EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_MINUTE=6
MAX_REQUEST_BODY_BYTES=32768
NBA_UPSTREAM_MAX_CONCURRENCY=4
NBA_UPSTREAM_QUEUE_TIMEOUT_SECONDS=2

# Optional verified model bootstrap. Set both values together.
ARTIFACT_BASE_URL=
ARTIFACT_EXPECTED_SHA256=

# Optional external dataset object; /api/v1/ml/dataset.csv redirects here.
DATASET_PUBLIC_URL=

# Optional Gemini-backed AI Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_RESPONSE_CACHE=1
AI_RESPONSE_CACHE_TTL=43200
AI_MAX_REMOTE_CALLS=4
AI_MAX_OUTPUT_TOKENS=1600
AI_THINKING_LEVEL=low
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_CONCURRENT_REPORTS=2
AI_GLOBAL_REPORTS_PER_MINUTE=8
